generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SOCIO
  ADMIN
  ATENCION_CLIENTE
  AUDITOR
}

enum TransactionType {
  PURCHASE
  RETURN
  REDEMPTION
  ADJUSTMENT
}

enum ChequeStatus {
  ACTIVE
  REDEEMED
  VOID
  EXPIRED
}

// Identidad de autenticación. Los socios (customers) y el staff interno
// (admin/atención al cliente/auditor) comparten la misma tabla de login,
// pero solo los SOCIO tienen un Customer/Account asociados.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(SOCIO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer  Customer?
  auditLogs AuditLog[]

  @@map("users")
}

model Customer {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String?
  dateOfBirth  DateTime?
  consentAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  account     Account?
  promotions  CustomerPromotion[]

  @@map("customers")
}

model Account {
  id             String   @id @default(uuid())
  customerId     String   @unique
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currentBalance Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions Transaction[]
  ledgerEntries PointLedgerEntry[]
  cheques      Cheque[]

  @@map("accounts")
}

// Ledger inmutable: nunca se hace UPDATE ni DELETE sobre estas filas,
// solo INSERT. El saldo de la cuenta es una proyección derivada.
model PointLedgerEntry {
  id             String   @id @default(uuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pointsChange   Int
  reason         String
  transactionId  String?
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  auditReference String?
  createdAt      DateTime @default(now())

  @@index([accountId])
  @@map("point_ledger_entries")
}

model Transaction {
  id                String          @id @default(uuid())
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type              TransactionType
  amount            Decimal         @db.Decimal(12, 2)
  externalEventId   String?         @unique
  description       String?
  relatedEntityType String?
  relatedEntityId   String?
  orderId           String?
  createdAt         DateTime        @default(now())

  ledgerEntries PointLedgerEntry[]
  cheques       Cheque[]

  @@index([accountId])
  @@map("transactions")
}

model Cheque {
  id                  String       @id @default(uuid())
  accountId           String
  account              Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  value                Decimal     @db.Decimal(12, 2)
  issueDate            DateTime    @default(now())
  expiryDate           DateTime
  status               ChequeStatus @default(ACTIVE)
  issuedByTransactionId String?
  issuedByTransaction   Transaction? @relation(fields: [issuedByTransactionId], references: [id])
  redemptionOrderId    String?
  redeemedAt           DateTime?
  voidReason           String?
  createdAt            DateTime    @default(now())

  @@index([accountId])
  @@map("cheques")
}

model Promotion {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  startDate          DateTime
  endDate            DateTime
  eligibilityCriteria Json    @default("{}")
  priority           Int      @default(0)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignedTo CustomerPromotion[]

  @@map("promotions")
}

model CustomerPromotion {
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  promotionId  String
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now())

  @@id([customerId, promotionId])
  @@map("customer_promotions")
}

// Versionado append-only de la configuración del motor de puntos.
// La versión vigente es siempre la de mayor `version`. Cambiar la
// configuración nunca reescribe versiones anteriores (RF-AYA-006).
model PointsEngineConfig {
  id                  String   @id @default(uuid())
  version             Int
  earnRatio           Decimal  @db.Decimal(8, 4)
  chequeThresholdPoints Int
  chequeValue         Decimal  @db.Decimal(12, 2)
  chequeExpiryDays    Int
  exclusions          Json     @default("[]")
  effectiveFrom       DateTime @default(now())
  updatedBy           String?
  changeReason        String?
  createdAt           DateTime @default(now())

  @@map("points_engine_config")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
